!.env.example

# Node / Vite
node_modules/
# 권한 문제로 이름을 바꿔 치운 node_modules 사본(root 소유라 지울 수 없음) — 예: node_modules.root-mixed-20261007
node_modules.*/
frontend/dist/
*.local

# 매크로 실행기 빌드 산출물 (exe 는 GitHub Releases 로 배포; 소스만 커밋)
