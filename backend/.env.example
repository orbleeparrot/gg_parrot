# 로컬 개발용 환경변수 예시. 이 파일을 복사해서 `.env` 로 만들고 값을 채우세요.
#   cp .env.example .env
# 실제 키가 든 `.env` 는 .gitignore 로 커밋되지 않습니다. 키를 코드에 넣지 마세요.
#
# 배포(Render)에서는 이 파일을 쓰지 않고, 대시보드의 Environment 에 같은 이름으로 넣습니다.

# 껄무새 AI 원인 분석 / 데일리 챌린지(선택). 비워두면 규칙기반/템플릿으로 자동 동작.
# 서버 전용 Anthropic 키 — 코드에 하드코딩 금지. 로컬은 이 .env, 배포는 Render 환경변수에.
ANTHROPIC_API_KEY=
# 사용할 모델. 중앙 뉴스 worker는 낮은 호출 상한과 Haiku를 기본으로 둡니다.
ANTHROPIC_MODEL=claude-haiku-4-5
# 포지션 맞춤 뉴스는 최대 6시간 또는 헤드라인이 바뀔 때까지 분석을 재사용합니다.
ANTHROPIC_POSITION_NEWS_MAX_TOKENS=256
POSITION_NEWS_ANALYSIS_CACHE_SECONDS=21600
POSITION_NEWS_DEGRADED_CACHE_SECONDS=60
POSITION_NEWS_ANALYSIS_CACHE_MAX_ENTRIES=256
# 새 헤드라인 AI 분석 비용 보호(프로세스별 sliding window). 캐시 hit는 차감하지 않습니다.
POSITION_NEWS_AI_RATE_WINDOW_SECONDS=3600
POSITION_NEWS_AI_USER_MAX_ANALYSES=12
POSITION_NEWS_AI_GLOBAL_MAX_ANALYSES=120

# --- 계정 / 포인트 (Supabase Postgres) ---------------------------------
# 비워두면 로컬 SQLite(backend/app.db)로 동작합니다. 배포에서는 Supabase의
# Postgres 연결 문자열을 넣으세요(비밀번호 포함 → 절대 커밋 금지).
#   Supabase 대시보드 → Project Settings → Database → Connection string
#   (Vercel/Render처럼 상주 서버는 'Session pooler' 문자열 권장)
# 예: postgresql://postgres.xxxx:비밀번호@aws-0-xx.pooler.supabase.com:5432/postgres
DATABASE_URL=
# JWT 세션 서명 키. 배포에서는 길고 무작위한 값으로 반드시 교체하세요.
#   생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 세션 유효시간(시간). 기본 168시간(7일).
SESSION_TTL_HOURS=168
# 내 에이전트의 실행 세션 WebSocket 연결에만 쓰이는 짧은 교환 토큰(15~300초).
RUNNER_SESSION_STREAM_TTL_SECONDS=60
# 여러 서버 프로세스 사이에서 누락된 알림을 DB 기준으로 다시 맞추는 주기(5~60초).
RUNNER_SESSION_WS_RESYNC_SECONDS=15
# 동일 프로세스 이벤트를 놓쳤거나 여러 서버 인스턴스인 경우의 DB 재동기화 주기(5~60초).
RUNNER_SESSION_WS_RESYNC_SECONDS=15

# --- 비밀번호 재설정 이메일 (Resend, 선택) -----------------------------
# 아래를 채우면 '비밀번호 찾기'가 실제 메일을 보냅니다. 비워두면 기능은 동작하되
# 메일이 발송되지 않습니다(안전한 no-op).
#   RESEND_API_KEY: resend.com 발급 키.  RESET_FROM_EMAIL: 인증된 발신 주소.
#   FRONTEND_BASE_URL: 재설정 링크 도메인(예: https://gg-parrot.vercel.app)
RESEND_API_KEY=
RESET_FROM_EMAIL=
FRONTEND_BASE_URL=

# --- 프로젝트 확장 설정 (Prefect / Supabase CLI / Google) ---------------

# Supabase CLI 전용(선택). 앱 런타임의 회원 DB 연결은 위 DATABASE_URL을 사용합니다.
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# 중앙 티커 뉴스 수집(Prefect worker)
POSITION_NEWS_COLLECTION_SECONDS=300
POSITION_NEWS_MAX_TICKERS_PER_RUN=100
POSITION_NEWS_MAX_AI_ANALYSES_PER_RUN=2
POSITION_NEWS_MAX_AI_ANALYSES_PER_DAY=10
POSITION_NEWS_MAX_CYCLE_SECONDS=240
POSITION_NEWS_MAX_SCHEDULE_LAG_SECONDS=600
POSITION_NEWS_MAX_CONSECUTIVE_FETCH_FAILURES=3
POSITION_NEWS_RETENTION_DAYS=30
POSITION_NEWS_CLAIM_TIMEOUT_SECONDS=300
POSITION_NEWS_DEGRADED_RETRY_SECONDS=300
POSITION_NEWS_STALE_SECONDS=900
# CoinDesk 공개 섹션·태그 페이지를 Chromium으로 렌더링합니다. 실패한 소스만
# Google News RSS의 CoinDesk 제한 검색으로 자동 대체됩니다.
COINDESK_PLAYWRIGHT_ENABLED=true
COINDESK_PLAYWRIGHT_TIMEOUT_MS=15000
# Render worker에서는 true로 설정해 SQLite 오접속을 즉시 실패시킵니다.
POSITION_NEWS_REQUIRE_POSTGRES=false

# Prefect Cloud workspace. FastAPI 웹 서버가 아니라 별도 worker에 필요합니다.
PREFECT_API_URL=
PREFECT_API_KEY=

# Supabase Session Pooler 연결/쿼리 제한
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# 백테스트 계산/응답 상한. 1년 1시간봉(8,760개)은 허용하되 과도한 분봉은 거절합니다.
BACKTEST_MAX_BARS=20000
BACKTEST_EQUITY_MAX_POINTS=1000
OPTIMIZE_MAX_BARS=10000
OPTIMIZE_PROCESS_WORKERS=1
OPTIMIZE_MAX_IN_FLIGHT=1
OPTIMIZE_CACHE_TTL_SECONDS=300
OPTIMIZE_CACHE_MAX_ENTRIES=64

# 외부 공개 API 연결 풀·병렬 I/O (Binance/RSS/시장 지표 공용)
EXTERNAL_HTTP_TIMEOUT_SECONDS=10
EXTERNAL_HTTP_MAX_CONNECTIONS=32
EXTERNAL_HTTP_KEEPALIVE_CONNECTIONS=16
EXTERNAL_HTTP_PARALLEL_WORKERS=8

# AI 호출 보호: 타임아웃·재시도·동시성·TTL/해시 캐시
AI_TIMEOUT_SECONDS=15
AI_MAX_CONCURRENT=3
AI_ACQUIRE_TIMEOUT_SECONDS=0.1
AI_RETRIES=1
AI_RETRY_BACKOFF_SECONDS=0.25
AI_CACHE_TTL_SECONDS=900
AI_CACHE_MAX_ENTRIES=512
OPTIMIZE_TIMEOUT_SECONDS=60
# Paper 상태는 매 가격 tick마다 쓰지 않고 이 간격으로 묶어서 저장합니다.
# 체결 및 세션 종료는 이 주기와 무관하게 즉시 저장됩니다.
PAPER_CHECKPOINT_SECONDS=20

# Google Identity Services의 OAuth 2.0 Web client ID(공개 식별자)
GOOGLE_CLIENT_ID=
